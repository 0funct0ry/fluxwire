# Log in

```http
POST https://api.example.com/login
Content-Type: application/json

{
  "user": "demo",
  "password": "{{password}}"
}
```

```http expect
HTTP 200
Content-Type: application/json
```

```ts test
fw.test("jsonpath \"$.token\" exists", () => fw.expect(fw.jsonpath(fw.response.json(), "$.token")[0] !== undefined && fw.jsonpath(fw.response.json(), "$.token")[0] !== null).toBeTruthy());
fw.test("jsonpath \"$.user.name\" == \"demo\"", () => fw.expect(JSON.stringify(fw.jsonpath(fw.response.json(), "$.user.name")[0]) === JSON.stringify("demo")).toBeTruthy());
fw.test("jsonpath \"$.roles\" count > 0", () => fw.expect((fw.jsonpath(fw.response.json(), "$.roles")[0]).length > 0).toBeTruthy());
fw.test("duration < 1000", () => fw.expect(fw.response.time < 1000).toBeTruthy());
```

