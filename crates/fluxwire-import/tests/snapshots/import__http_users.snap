# createUser

```http
POST {{host}}/users
Content-Type: {{contentType}}
X-Request-Id: {{$uuid}}

{
  "name": "Ada"
}
```

```ts test
const client = {
  global: { set: (k, v) => fw.vars.set(k, v), get: (k) => fw.vars.get(k) },
  test: (name, fn) => fw.test(name, fn),
  assert: (cond, msg) => { if (!cond) throw new Error(msg ?? "assertion failed"); },
  log: (...a) => console.log(...a),
};
const response = {
  get status() { return fw.response.status; },
  get body() { return fw.response.json(); },
  headers: { valueOf: (n) => fw.response.headers.get(n) },
  contentType: { get mimeType() { return (fw.response.headers.get("content-type") ?? "").split(";")[0]; } },
};
client.test("created", function () {
  client.assert(response.status === 201, "expected 201");
});
client.global.set("userId", response.body.id);
client.log("done");
client.exit();
```

