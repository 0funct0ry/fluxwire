{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/fluxwire/index.html", "http://localhost/fluxwire/docs/index.html", "http://localhost/fluxwire/docs/reference/flux-format/index.html"]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
